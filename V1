// ---------- RENDER ----------
function batchClass(b){ return b==='a' ? 'batchA' : b==='b' ? 'batchB' : ''; }
function dotClass(b){ return b==='a' ? 'a' : b==='b' ? 'b' : 'f'; }

weeks.forEach(w=>{
  const el = document.getElementById(w.id);
  let html = `<div class="week-note"><b>${w.label}.</b> ${w.note}</div>`;
  html += `<div class="legend">
      <span><span class="dot a"></span>Batch A</span>
      <span><span class="dot b"></span>Batch B</span>
      <span><span class="dot f"></span>Flex day</span>
    </div>`;
  html += `<div class="week-grid">`;
  w.days.forEach(day=>{
    html += `<div class="day ${batchClass(day.batch)}">
      <span class="tag">${day.tag}</span>
      <h3>${day.d}</h3>`;
    Object.entries(day.meals).forEach(([label,val])=>{
      html += `<div class="meal-row"><span class="lbl">${label}</span>${val}</div>`;
    });
    html += `</div>`;
  });
  html += `</div>`;
  el.innerHTML = html;
});

const recipesEl = document.getElementById('recipes');
let rHtml = '';
recipes.forEach(group=>{
  rHtml += `<div class="recipe-group"><h2>${group.group}</h2>`;
  group.items.forEach(r=>{
    rHtml += `<details class="card">
      <summary>${r.title} <span class="badge ${r.batch}">Batch ${r.batch.toUpperCase()}</span><span class="plus">+</span></summary>
      <div class="body">
        <p style="color:var(--ink);margin:0 0 10px;">${r.makes}</p>
        <h4>Ingredients</h4>
        <ul>${r.ingredients.map(i=>`<li>${i}</li>`).join('')}</ul>
        <h4>Steps</h4>
        <ol>${r.steps.map(s=>`<li>${s}</li>`).join('')}</ol>
      </div>
    </details>`;
  });
  rHtml += `</div>`;
});
recipesEl.innerHTML = rHtml;

